{
  "name": "stow-file-uploader",
  "version": "1.0.0",
  "private": true,
  "description": "A personal file library with private uploads, nested folders, and expiring share links.",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "prisma generate && tsc",
    "start": "node dist/server.js",
    "setup": "node scripts/setup.mjs",
    "db:migrate": "prisma migrate deploy",
    "db:generate": "prisma generate",
    "demo": "tsx scripts/seed.ts",
    "test": "tsx --test --test-concurrency=1 tests/*.test.ts",
    "test:ui": "playwright test",
    "check": "tsc --noEmit && eslint .",
    "format": "prettier --write . && node scripts/format-views.mjs",
    "format:check": "prettier --check . && node scripts/format-views.mjs --check"
  },
  "dependencies": {
    "@prisma/adapter-better-sqlite3": "7.10.0",
    "@prisma/client": "7.10.0",
    "@quixo3/prisma-session-store": "^3.1.21",
    "better-sqlite3": "^12.11.1",
    "cloudinary": "^2.11.0",
    "dotenv": "^17.2.3",
    "ejs": "^3.1.10",
    "express": "^5.2.1",
    "express-rate-limit": "^8.2.1",
    "express-session": "^1.18.2",
    "file-type": "^22.1.1",
    "helmet": "^8.1.0",
    "multer": "^2.4.0",
    "passport": "^0.7.0",
    "passport-local": "^1.0.0",
    "zod": "^4.3.6"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.2",
    "mysql2": "^3.24.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.58.2",
    "@types/better-sqlite3": "^7.6.13",
    "@types/ejs": "^3.1.5",
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.18.2",
    "@types/multer": "^2.0.0",
    "@types/node": "^26.6.3",
    "@types/passport": "^1.0.17",
    "@types/passport-local": "^1.0.38",
    "@types/supertest": "^6.0.3",
    "eslint": "^9.39.1",
    "globals": "^16.5.0",
    "prettier": "^3.7.4",
    "prisma": "7.10.0",
    "sharp": "^0.35.5",
    "supertest": "^7.2.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.48.1"
  }
}
