NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
DATABASE_URL=file:./data/stow.db
# npm run setup generates a random secret in .env.
SESSION_SECRET=replace-with-a-random-secret-of-at-least-32-characters
STORAGE_PROVIDER=local
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=10
USER_QUOTA_MB=100
# Enable only when running behind one trusted reverse proxy.
TRUST_PROXY=false
# Required when STORAGE_PROVIDER=cloudinary.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
