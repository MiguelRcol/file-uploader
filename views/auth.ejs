<%- include('partials/head') %>
<div class="auth-page">
  <aside class="auth-story">
    <%- include('partials/brand') %>
    <div class="auth-story-main">
      <span class="eyebrow">YOUR FILES. YOUR SPACE.</span>
      <h1>A home for<br />everything<br />you’re making<span>.</span></h1>
      <p>Keep your ideas close, your files in order,<br />and your next chapter within reach.</p>
      <div class="auth-art" aria-hidden="true">
        <div class="auth-folder lavender"><%- include('partials/icon', { name: 'folder' }) %><span>Little ideas</span></div>
        <div class="auth-folder peach"><%- include('partials/icon', { name: 'folder' }) %><span>Big plans</span></div>
        <div class="auth-folder sage"><%- include('partials/icon', { name: 'folder' }) %><span>Good things</span></div>
        <span class="auth-spark">✳</span>
      </div>
    </div>
    <span class="auth-footer">A little less scattered. A little more you.</span>
  </aside>
  <main id="main" class="auth-main">
    <a href="/" class="back-link"><%- include('partials/icon', { name: 'arrow-left' }) %> Back to home</a>
    <div class="auth-form-wrap">
      <span class="eyebrow"><%= page === 'login' ? 'PICK UP WHERE YOU LEFT OFF' : 'MAKE ROOM FOR WHAT’S NEXT' %></span>
      <h2><%= title %><span class="heading-dot">.</span></h2>
      <p class="muted"><%= page === 'login' ? 'Your files are right where you left them.' : 'A fresh space for your files, ideas, and plans.' %></p>
      <% if (error) { %>
      <div class="notice error" role="alert">
        <%- include('partials/icon', { name: 'info' }) %><span><%= error %></span>
      </div>
      <% } %>
      <form method="post" action="/<%= page %>" class="auth-form">
        <input type="hidden" name="_csrf" value="<%= csrf %>" /><% if (page === 'signup') { %><label
          class="field-label"
          for="name"
          >Your name</label
        ><input
          class="field-input"
          id="name"
          name="name"
          autocomplete="name"
          value="<%= values.name || '' %>"
          minlength="2"
          maxlength="60"
          placeholder="Alex Morgan"
          required
        /><% } %><label class="field-label" for="email">Email address</label
        ><input
          class="field-input"
          id="email"
          name="email"
          type="email"
          autocomplete="email"
          value="<%= values.email || '' %>"
          maxlength="254"
          placeholder="you@example.com"
          required
        />
        <div class="password-label">
          <label class="field-label" for="password">Password</label
          ><button
            class="text-button small"
            data-password-toggle
            type="button"
            aria-controls="password"
            aria-pressed="false"
          >
            Show
          </button>
        </div>
        <input
          class="field-input"
          id="password"
          name="password"
          type="password"
          autocomplete="<%= page === 'signup' ? 'new-password' : 'current-password' %>"
          minlength="<%= page === 'signup' ? 10 : 1 %>"
          maxlength="128"
          placeholder="<%= page === 'signup' ? 'At least 10 characters' : 'Enter your password' %>"
          required
        /><% if (page === 'signup') { %>
        <p class="form-hint">Use a unique password with at least 10 characters.</p>
        <% } %><button class="button button-primary auth-submit">
          <%= page === 'login' ? 'Sign in' : 'Create account' %><%- include('partials/icon', { name: 'arrow-right' }) %>
        </button>
      </form>
      <p class="auth-switch">
        <%= page === 'login' ? 'New around here?' : 'Already have a space?' %> <a href="/<%= page === 'login' ? 'signup' : 'login' %>"><%= page === 'login' ? 'Create an account' : 'Sign in' %></a>
      </p>
      <div class="auth-assurance"><%- include('partials/icon', { name: 'lock' }) %> Private by default. Always your space.</div>
    </div>
  </main>
</div>
<%- include('partials/foot') %>
